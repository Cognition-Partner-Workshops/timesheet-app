# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT Configuration (IMPORTANT: Use a strong, random secret in production!)
JWT_SECRET=changeme-use-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=24h

# Database Configuration (using SQLite in-memory as specified for local dev)
# No database configuration needed for in-memory SQLite.
# The production config (src/config/production.js) expects the following to be
# provided via the environment / a secrets manager (never commit real values):
DATABASE_URL=<set-in-environment>
SENDGRID_API_KEY=<set-in-environment>
