[General]
Type=General
DefaultCfg=default.cfg
NewFuncCfg=default.cfg
AdditionalTypes=
LastModifyDate=0
ScriptLanguage=C
ParameterFile=SC04_Report_Generation.prm

[Transactions]
T10_Navigate_Reports=
T11_Load_Client_Report=
T12_Export_CSV=
T13_Export_PDF=

[RunLogicInitAction]
vuser_init=vuser_init.c

[RunLogicRunAction]
Action=Action.c

[RunLogicEndAction]
vuser_end=vuser_end.c

[Script]
vuser_init=vuser_init.c
Action=Action.c
vuser_end=vuser_end.c

[Profile]
CfgFile=default.cfg

[WEB]
URL_1=http://localhost:3001
URL_2=http://localhost:5173

[HTTP]
FollowRedirects=1
MaxRedirects=10
ConnectTimeout=120
ReceiveTimeout=600
UseProxy=0

[ThinkTime]
Options=RECORDED
Factor=1
LimitFlag=1
Limit=30

[Iterations]
NumOfIterations=1
IterationPace=IterationASAP
StartEvery=60
RandomMin=0
RandomMax=0

[Log]
LogOptions=LogBrief
MsgClassData=0
MsgClassParameters=0
MsgClassFull=0

[Pacing]
NumberOfIterations=1
PacingType=0

[Run]
Action=Action
vuser_init=vuser_init
vuser_end=vuser_end

[Parameters]
P_UserEmail=params/users.dat
C_ClientId=
C_TotalHours=
C_EntryCount=

[ParameterConfig_P_UserEmail]
ColumnName=P_UserEmail
Delimiter=,
ParamName=P_UserEmail
TableLocation=Local
Type=Table
GenerateNewVal=EachIteration
OriginalValue=perf_user01@loadtest.com
OutOfRangePolicy=ContinueWithLast
SelectNextRow=Unique
StartRow=1
Table=params/users.dat
