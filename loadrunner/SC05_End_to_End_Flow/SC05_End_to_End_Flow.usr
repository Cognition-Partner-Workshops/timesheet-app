[General]
Type=Multi
DefaultCfg=default.cfg
AdditionalTypes=
ParameterFile=SC05_End_to_End_Flow.prm
GlobalParameterFile=
Description=SC-05: End-to-End Business Flow (Login -> Client -> Work Entry -> Dashboard -> Report -> Export)
NewFunctionHeader=1

[Transactions]
T14_E2E_Launch=T14_E2E_Launch
T15_E2E_Login=T15_E2E_Login
T16_E2E_Dashboard=T16_E2E_Dashboard
T17_E2E_Nav_Clients=T17_E2E_Nav_Clients
T18_E2E_Create_Client=T18_E2E_Create_Client
T19_E2E_Nav_WorkEntries=T19_E2E_Nav_WorkEntries
T20_E2E_Create_WorkEntry=T20_E2E_Create_WorkEntry
T21_E2E_Verify_Dashboard=T21_E2E_Verify_Dashboard
T22_E2E_Nav_Reports=T22_E2E_Nav_Reports
T23_E2E_View_Report=T23_E2E_View_Report
T24_E2E_Export_CSV=T24_E2E_Export_CSV

[Actions]
vuser_init=vuser_init.c
Actions=Action.c
vuser_end=vuser_end.c

[RunLogicFiles]
vuser_init=vuser_init.c
Actions=Action.c
vuser_end=vuser_end.c

[RunLogicRunItem]
vuser_init=1
Actions=1
vuser_end=1

[RunLogicAction]
Iterations=1
IterationPace=ConstTime,0,0
ContinueOnError=0

[ThinkTime]
Options=RECORDED
Factor=1
LimitFlag=1
Limit=60

[Log]
LogOptions=LogBrief
MsgClassData=0
MsgClassParameters=0
MsgClassFull=0

[Network]
Speed=MAX
BandwidthFactor=100

[Browser Emulation]
UserAgent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
BrowserCaching=ClearEachIteration
DownloadNonHTMLResources=1
SimulateNewUserEachIteration=1
RemoveThinkTimeInLogAndReplay=0
ParseHTMLContentType=TEXT

[ContentCheck]
TextCheckPoint=1
ResourceCheck=0
ResourceThreshold=0

[HTTP]
KeepAlive=1
ConnectionPoolSize=100
MaxRedirections=10
ProxyUsage=0

[Proxy]
ProxyType=0
ProxyServer=
ProxyPort=0
ProxyBypass=

[Parameters]
; P_UserEmail - Parameterized user email for login
P_UserEmail=params/users.dat
; P_ClientName, P_Department, P_ClientEmail, P_ClientDescription
P_ClientName=params/clients.dat
P_Department=params/clients.dat
P_ClientEmail=params/clients.dat
P_ClientDescription=params/clients.dat
; P_Hours, P_EntryDate, P_WorkDescription
P_Hours=params/workentries.dat
P_EntryDate=params/workentries.dat
P_WorkDescription=params/workentries.dat

[ParameterConfig:P_UserEmail]
Table=params/users.dat
Column=P_UserEmail
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=1
OutOfRangePolicy=ContinueWithLast
SelectNextRow=Unique
StartRow=1

[ParameterConfig:P_ClientName]
Table=params/clients.dat
Column=P_ClientName
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=1
OutOfRangePolicy=ContinueWithLast
SelectNextRow=Sequential
StartRow=1
SameLineAs=P_ClientName

[ParameterConfig:P_Department]
Table=params/clients.dat
Column=P_Department
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=2
OutOfRangePolicy=ContinueWithLast
SelectNextRow=SameAsP_ClientName
StartRow=1
SameLineAs=P_ClientName

[ParameterConfig:P_ClientEmail]
Table=params/clients.dat
Column=P_ClientEmail
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=3
OutOfRangePolicy=ContinueWithLast
SelectNextRow=SameAsP_ClientName
StartRow=1
SameLineAs=P_ClientName

[ParameterConfig:P_ClientDescription]
Table=params/clients.dat
Column=P_ClientDescription
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=4
OutOfRangePolicy=ContinueWithLast
SelectNextRow=SameAsP_ClientName
StartRow=1
SameLineAs=P_ClientName

[ParameterConfig:P_Hours]
Table=params/workentries.dat
Column=P_Hours
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=1
OutOfRangePolicy=ContinueWithLast
SelectNextRow=Sequential
StartRow=1
SameLineAs=P_Hours

[ParameterConfig:P_EntryDate]
Table=params/workentries.dat
Column=P_EntryDate
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=2
OutOfRangePolicy=ContinueWithLast
SelectNextRow=SameAsP_Hours
StartRow=1
SameLineAs=P_Hours

[ParameterConfig:P_WorkDescription]
Table=params/workentries.dat
Column=P_WorkDescription
Delimiter=,
Row=1
Type=Table
GenerateNewValue=EachIteration
ColumnIndex=3
OutOfRangePolicy=ContinueWithLast
SelectNextRow=SameAsP_Hours
StartRow=1
SameLineAs=P_Hours
