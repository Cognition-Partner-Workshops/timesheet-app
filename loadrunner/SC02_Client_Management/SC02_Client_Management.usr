[General]
Type=Multi
DefaultCfg=default.cfg
NewFunctionHeader=1
DisableAlarm=0
AdditionalTypes=
ParameterFile=default.prm
LastActiveAction=Action
ActiveActions=vuser_init,Action,vuser_end
GenerateTypes=0
RunType=0
ScriptLanguage=C

[Actions]
vuser_init=vuser_init.c
Action=Action.c
vuser_end=vuser_end.c

[RunLogicInitAction]
Name=vuser_init

[RunLogicEndAction]
Name=vuser_end

[RunLogicRunAction]
Name=Action

[Iteration]
NumOfIterations=1
IterationPace=ConstantPace
ConstPaceValue=0

[Log]
LogOptions=LogBrief
MsgClassData=0
MsgClassParameters=0
MsgClassFull=0

[ThinkTime]
Options=RECORDED
Factor=1
LimitFlag=0
Limit=0

[Pacing]
NumOfIterations=1
Type=0
ConstPaceValue_ms=0
RandomPaceLow_ms=0
RandomPaceHigh_ms=0

[Network]
Speed=0

[Browser]
BrowserEmulation=1
UserAgent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

[ConnectionPool]
NumConnPerServer=6

[General:Parameters]
P_UserEmail=params/users.dat
P_ClientName=params/clients.dat
P_Department=params/clients.dat
P_ClientEmail=params/clients.dat
P_ClientDescription=params/clients.dat

[Parameter:P_UserEmail]
Delimiter=","
ParamName=P_UserEmail
TableLocation=Local
ColumnIndex=1
GenerateNewVal=EachIteration
Type=Table
value_for_each_vuser=
OriginalValue=
OutOfRangePolicy=ContinueWithLast
Table=params/users.dat
SelectNextRow=Sequential
StartRow=1
ColumnName=P_UserEmail

[Parameter:P_ClientName]
Delimiter=","
ParamName=P_ClientName
TableLocation=Local
ColumnIndex=1
GenerateNewVal=EachIteration
Type=Table
value_for_each_vuser=
OriginalValue=
OutOfRangePolicy=ContinueWithLast
Table=params/clients.dat
SelectNextRow=Sequential
StartRow=1
ColumnName=P_ClientName

[Parameter:P_Department]
Delimiter=","
ParamName=P_Department
TableLocation=Local
ColumnIndex=2
GenerateNewVal=SameAsP_ClientName
Type=Table
value_for_each_vuser=
OriginalValue=
OutOfRangePolicy=ContinueWithLast
Table=params/clients.dat
SelectNextRow=SameAsP_ClientName
StartRow=1
ColumnName=P_Department

[Parameter:P_ClientEmail]
Delimiter=","
ParamName=P_ClientEmail
TableLocation=Local
ColumnIndex=3
GenerateNewVal=SameAsP_ClientName
Type=Table
value_for_each_vuser=
OriginalValue=
OutOfRangePolicy=ContinueWithLast
Table=params/clients.dat
SelectNextRow=SameAsP_ClientName
StartRow=1
ColumnName=P_ClientEmail

[Parameter:P_ClientDescription]
Delimiter=","
ParamName=P_ClientDescription
TableLocation=Local
ColumnIndex=4
GenerateNewVal=SameAsP_ClientName
Type=Table
value_for_each_vuser=
OriginalValue=
OutOfRangePolicy=ContinueWithLast
Table=params/clients.dat
SelectNextRow=SameAsP_ClientName
StartRow=1
ColumnName=P_ClientDescription

[Proxy]
UseProxy=0

[ContentCheck]
EnableContentCheck=1

[MiscOptions]
ContinueOnError=0
FailTransOnErrorMsg=1
