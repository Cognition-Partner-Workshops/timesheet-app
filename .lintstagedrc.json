{
  "backend/**/*.js": [
    "prettier --write",
    "backend/node_modules/.bin/eslint --config backend/eslint.config.js --fix --max-warnings=0"
  ],
  "frontend/**/*.{ts,tsx}": [
    "prettier --write",
    "frontend/node_modules/.bin/eslint --config frontend/eslint.config.js --fix --max-warnings=0"
  ],
  "**/*.{json,md,yml,yaml,css,html}": ["prettier --write"]
}
