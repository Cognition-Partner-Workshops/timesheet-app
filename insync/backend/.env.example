# ---------------------------------------------------------------------------
# InSync backend configuration
# Copy this file to `.env` and fill in values as needed.
# The app works fully WITHOUT any AI key (it falls back to a deterministic
# mock AI parser + explainer), so all AI variables are optional.
# ---------------------------------------------------------------------------

# Path to the workforce Excel workbook. Defaults to the bundled sample dataset.
INSYNC_DATA_FILE=data/workforce_dataset.xlsx

# Snapshot ("today") date used for all availability maths. Defaults to the
# dataset's snapshot date so the demo is deterministic regardless of real date.
INSYNC_SNAPSHOT_DATE=2026-06-22

# CORS origin for the frontend dev server.
INSYNC_FRONTEND_URL=http://localhost:5173

# ---- AI provider (optional) ----------------------------------------------
# Set INSYNC_AI_PROVIDER to "openai" or "azure" to enable real AI parsing and
# explanations. Leave empty / "mock" to use the built-in deterministic mock.
INSYNC_AI_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
