# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=insync_wfp
PGUSER=postgres
PGPASSWORD=postgres

# Excel source file
EXCEL_PATH=/path/to/InSync_Hackathon_APAC_India_MENA_WFP_Dataset_500(2).xlsx

# Encryption key for employee names.
# Generate with:
# python -m src.security.crypto --generate-key
FERNET_KEY=replace_with_generated_fernet_key

# Salt used for employee name exact-match hash.
NAME_HASH_SALT=replace_with_long_random_salt

# Keep false for safer storage. Raw source payloads will mask names and sensitive values.
STORE_RAW_PII=false

# Seeded MVP users. Later this can come from SSO/admin screen.
SARAH_NAME=Sarah Planner
SARAH_EMAIL=sarah.planner@example.com
JENNY_NAME=Jenny Client Manager
JENNY_EMAIL=jenny.client@example.com
RAJ_NAME=Raj Delivery Manager
RAJ_EMAIL=raj.delivery@example.com

# Optional reference date for calculating 30/60/90 capacity.
# If blank, earliest WeekStartDate from Availability Calendar is used.
REFERENCE_DATE=
